{
  "name": "culinaryos",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source, self-hostable restaurant OS",
  "bin": {
    "culinary": "./cli/dist/index.js",
    "culinaryos": "./cli/dist/index.js",
    "create-culinaryos": "./cli/dist/index.js"
  },
  "scripts": {
    "setup": "tsx scripts/quickstart.ts",
    "launch": "tsx scripts/quickstart.ts",
    "start": "tsx scripts/quickstart.ts",
    "dev": "turbo run dev",
    "desktop": "pnpm --filter @culinaryos/app-desktop dev",
    "mobile": "pnpm --filter culinaryos-mobile start",
    "mobile:android": "pnpm --filter culinaryos-mobile android",
    "mobile:build:android": "pnpm --filter culinaryos-mobile build:android",
    "server": "pnpm --filter @culinaryos/server dev",
    "pos": "pnpm --filter @culinaryos/app-pos dev",
    "kds": "pnpm --filter @culinaryos/app-kds dev",
    "admin": "pnpm --filter @culinaryos/admin dev",
    "web": "pnpm --filter @culinaryos/app-web dev",
    "ops": "pnpm --filter @culinaryos/app-ops dev",
    "kitchenkit": "pnpm --filter @culinaryos/app-kitchenkit dev",
    "recipeos": "pnpm --filter @culinaryos/app-recipeos dev",
    "dev:kitchenkit": "pnpm --filter @culinaryos/app-kitchenkit dev",
    "mcp": "pnpm --filter culinaryos-mcp-servers start",
    "mcp:all": "pnpm --filter culinaryos-mcp-servers start",
    "mcp:hub": "pnpm --filter culinaryos-mcp-servers dev",
    "start:all": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "//#test": "node ./scripts/run-all-tests.cjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/db/src/types.ts",
    "db:reset": "supabase db reset",
    "seed": "tsx scripts/seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "health": "tsx scripts/health-check.ts",
    "check": "tsx scripts/health-check.ts",
    "test:sim": "tsx scripts/test-e2e-simulation.ts",
    "test:e2e": "tsx scripts/test-e2e-simulation.ts",
    "check:all": "tsx scripts/audit-all.ts",
    "audit:all": "tsx scripts/audit-all.ts",
    "test:suite": "tsx scripts/audit-all.ts",
    "quickstart": "tsx scripts/quickstart.ts",
    "demo": "tsx scripts/quickstart.ts",
    "simulate": "tsx scripts/simulate-service.ts",
    "ops:audit": "tsx scripts/daily-ops-consultant.ts",
    "ops:consultant": "tsx scripts/daily-ops-consultant.ts",
    "local:supabase": "bash ./scripts/local-supabase.sh"
  },
  "devDependencies": {
    "@culinaryos/auth": "workspace:*",
    "@culinaryos/config": "workspace:*",
    "@culinaryos/db": "workspace:*",
    "@culinaryos/event-bus": "workspace:*",
    "@culinaryos/ratio-engine": "workspace:*",
    "@culinaryos/server": "workspace:*",
    "@culinaryos/shared": "workspace:*",
    "@supabase/supabase-js": "^2.43.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "tsx": "^4.7.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
