{
  "name": "culinaryos-mcp-servers",
  "version": "1.0.0",
  "description": "Local-first MCP microservice servers for CulinaryOS POS, KDS, and Inventory",
  "main": "dist/src/unified-server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/unified-server.js",
    "dev": "node --import tsx src/unified-server.ts",
    "start-pos": "node dist/src/pos-server.js",
    "start-kds": "node dist/src/kds-server.js",
    "start-inventory": "node dist/src/inventory-server.js",
    "start-recipe": "node dist/src/recipe-server.js",
    "start-prep": "node dist/src/prep-server.js",
    "start-post-pilot": "node dist/src/post-pilot-server.js",
    "start-culinaryops": "node dist/src/culinaryops-server.js",
    "dev-culinaryops": "node --import tsx src/culinaryops-server.ts",
    "start-culinaryops-live": "node --import tsx src/culinaryops-hub-live.ts",
    "dev-culinaryops-live": "node --import tsx src/culinaryops-hub-live.ts",
    "start-unified": "node dist/src/unified-server.js",
    "dev-unified": "node --import tsx src/unified-server.ts"
  },
  "dependencies": {
    "@culinaryos/ratio-engine": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "dotenv": "^16.4.5",
    "zod": "*",
    "@supabase/supabase-js": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "@types/node": "^20.12.0"
  }
}
