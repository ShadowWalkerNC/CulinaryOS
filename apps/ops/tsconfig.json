{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "types": ["vite/client"],
    "paths": {
      "react": ["node_modules/react"],
      "@supabase/supabase-js": ["node_modules/@supabase/supabase-js"],
      "@/*": ["./src/*"],
      "@culinaryos/food-cost-engine": ["../../packages/food-cost-engine/src/index.ts"],
      "@culinaryos/waste-engine": ["../../packages/waste-engine/src/index.ts"],
      "@culinaryos/labor-engine": ["../../packages/labor-engine/src/index.ts"],
      "@culinaryos/shared": ["../../packages/shared/src/index.ts"],
      "@culinaryos/ratio-engine": ["../../packages/ratio-engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
