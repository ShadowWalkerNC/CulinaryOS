{
  "name": "@culinaryos/server",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes/*": "./src/routes/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./middleware/*": "./src/middleware/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "dev:bun": "bun run --watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "pnpm --filter @culinaryos/config build && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "@culinaryos/auth": "workspace:*",
    "@culinaryos/commissary-engine": "workspace:^",
    "@culinaryos/config": "workspace:*",
    "@culinaryos/db": "workspace:*",
    "@culinaryos/event-bus": "workspace:*",
    "@culinaryos/food-cost-engine": "workspace:*",
    "@culinaryos/forecast-engine": "workspace:^",
    "@culinaryos/labor-engine": "workspace:*",
    "@culinaryos/pdf-tools": "workspace:^",
    "@culinaryos/shared": "workspace:*",
    "@culinaryos/waste-engine": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "@supabase/supabase-js": "^2.43.0",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "stripe": "^15.12.0",
    "tsx": "^4.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "bun-types": "latest",
    "typescript": "^5.4.0"
  }
}
