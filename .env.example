# ============================================================
# CulinaryOS — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Core Server Configuration
PORT=3000
SERVICE_NAME=culinaryos
# Canonical API base used for in-process/service callbacks
CULINARYOS_URL=http://localhost:3000
# Optional bare hostname (no scheme) — prefer CULINARYOS_URL
# CULINARYOS_HOST=localhost
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (server-side — service role bypasses RLS; use only after auth checks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (client-side — anon key, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Frontend Client URLs
VITE_API_URL=http://localhost:3000
VITE_POS_URL=http://localhost:3000
VITE_KDS_URL=http://localhost:3000

# Tenant for local dev / demo seed
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Device / terminal API key (POS/KDS) — same value as DEVICE_API_KEY on server
VITE_DEVICE_API_KEY=change-me-to-a-long-random-device-secret

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_51placeholder
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51placeholder

# AI Agent Layer
ANTHROPIC_API_KEY=your-anthropic-api-key

# Internal service API key — all services must share this
INTERNAL_API_KEY=change-me-to-a-long-random-secret
# Device terminals (POS/KDS) — optional separate key; falls back to INTERNAL_API_KEY
DEVICE_API_KEY=change-me-to-a-long-random-device-secret

# Auth: set AUTH_RELAXED=true only for local demo without Supabase
# (Also auto-relaxed when SUPABASE_URL is a placeholder.)
AUTH_RELAXED=true

# CORS allowlist (comma-separated). Empty = any localhost origin.
CORS_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174,http://localhost:5176,http://localhost:3000

# Realtime: clients use Supabase Realtime (not dedicated WS ports).
# Legacy KDS/POS websocket ports are unused in the apps/ stack.

# Pantry deduct + MCP bridges target the unified API
RECIPEOS_URL=http://localhost:3000
RECIPEOS_MCP_URL=http://localhost:3000
RECIPEOS_JWT_SECRET=your-recipeos-jwt-secret

# CulinaryOps operations satellite (labor / food-cost / vendor / waste),
# bridged into the hub via culinaryops-mcp (mcp/src/culinaryops-server.ts).
CULINARYOPS_URL=http://localhost:3004
