# ============================================================
# CulinaryOS — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Core Server Configuration
PORT=3000
SERVICE_NAME=culinaryos
CULINARYOS_HOST=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/culinaryos

# Supabase (server-side — service role bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase (client-side — anon key, safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Frontend Client URLs
VITE_API_URL=http://localhost:3000
VITE_POS_URL=http://localhost:3000
VITE_KDS_URL=http://localhost:3000

# Tenant for local dev / demo seed
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_51placeholder
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51placeholder

# AI Agent Layer
ANTHROPIC_API_KEY=your-anthropic-api-key

# Internal service API key — all services must share this
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Service URLs & Ports (used when services call each other)
CULINARYOS_URL=http://localhost:3000
RECIPEOS_URL=http://localhost:3001
KDS_URL=http://localhost:3002
POS_URL=http://localhost:3003
RECIPEOS_MCP_URL=http://localhost:3001
RECIPEOS_JWT_SECRET=your-recipeos-jwt-secret
KDS_WEBSOCKET_PORT=3002
POS_WEBSOCKET_PORT=3003
