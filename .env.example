# CulinaryOS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=culinaryos
DB_USER=culinaryos
DB_PASSWORD=your_secure_password_here

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_ISSUER=culinaryos
JWT_AUDIENCE=culinaryos-clients
# Access token TTL in minutes (default: 15)
JWT_ACCESS_TTL_MINUTES=15
# Refresh token TTL in days (default: 7)
JWT_REFRESH_TTL_DAYS=7

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# Set to: development | staging | production
ENVIRONMENT=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Email (optional at MVP — used for receipts) ──────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@culinaryos.com
