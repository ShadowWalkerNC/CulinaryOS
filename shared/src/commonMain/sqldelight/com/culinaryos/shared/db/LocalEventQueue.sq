-- CulinaryOS Local Event Queue
-- See docs/sync-protocol.md for full specification.
-- This table is the backbone of the offline-first sync engine.
-- Events are NEVER deleted. synced_at is set when the server confirms receipt.

CREATE TABLE IF NOT EXISTS local_event_queue (
    event_id       TEXT    NOT NULL PRIMARY KEY,
    restaurant_id  TEXT    NOT NULL,
    device_id      TEXT    NOT NULL,
    client_seq     INTEGER NOT NULL,
    client_ts      INTEGER NOT NULL,
    type           TEXT    NOT NULL,
    aggregate_id   TEXT    NOT NULL,
    payload        TEXT    NOT NULL,   -- JSON string
    synced_at      INTEGER             -- NULL = pending sync; Unix epoch ms when server confirmed
);

CREATE INDEX IF NOT EXISTS idx_leq_pending
    ON local_event_queue (restaurant_id, device_id, client_seq)
    WHERE synced_at IS NULL;

-- Queries

insertEvent:
INSERT INTO local_event_queue
(event_id, restaurant_id, device_id, client_seq, client_ts, type, aggregate_id, payload, synced_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL);

selectPending:
SELECT * FROM local_event_queue
WHERE synced_at IS NULL
ORDER BY device_id, client_seq ASC
LIMIT :limit;

markSynced:
UPDATE local_event_queue
SET synced_at = :syncedAt
WHERE event_id = :eventId;

selectMaxClientSeq:
SELECT COALESCE(MAX(client_seq), 0) FROM local_event_queue
WHERE device_id = :deviceId AND restaurant_id = :restaurantId;

countPending:
SELECT COUNT(*) FROM local_event_queue
WHERE synced_at IS NULL AND restaurant_id = :restaurantId;
